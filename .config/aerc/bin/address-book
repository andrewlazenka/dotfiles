#!/usr/bin/env python3
"""Search a locally cached TSV address book for aerc completion."""

import os
import sys
from pathlib import Path

cache_root = os.environ.get("XDG_CACHE_HOME", str(Path.home() / "Library/Caches"))
cache = Path(cache_root) / "aerc/address-book.tsv"
query = " ".join(sys.argv[1:]).casefold()

try:
    with cache.open(encoding="utf-8") as contacts:
        count = 0
        for line in contacts:
            if query in line.casefold():
                print(line, end="")
                count += 1
                if count >= 20:
                    break
except FileNotFoundError:
    # The startup refresh may still be running on the first launch.
    pass
