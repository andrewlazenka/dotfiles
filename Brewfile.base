# Common Homebrew dependencies for personal and work machines.
# Install through the appropriate profile without upgrading existing packages:
#   brew bundle install --file=./Brewfile.personal --no-upgrade
#   brew bundle install --file=./Brewfile.work --no-upgrade

# Third-party taps. Individual formula entries below opt into trust rather than
# trusting the entire tap.
tap "bramstein/webfonttools", "https://github.com/bramstein/homebrew-webfonttools"

# GNU and system tools
brew "coreutils"
brew "moreutils"
brew "findutils"
brew "gnu-sed"
brew "bash"
brew "bash-completion@2"
brew "neovim"
brew "grep"
brew "openssh"
brew "gmp"
brew "git"
brew "git-lfs"
brew "tree"
brew "gcc"
brew "pnpm"
cask "docker-desktop"
brew "docker-compose"
brew "tmux"
brew "herdr"
brew "dockutil"
brew "atuin"
brew "fzf"
brew "jq"
brew "httpie"
brew "rclone"
brew "pandoc"
brew "ffmpeg"
brew "cloc"

# Font conversion tools
brew "bramstein/webfonttools/sfnt2woff", trusted: true
brew "woff2"

# Fonts
cask "font-cascadia-code"
cask "font-jetbrains-mono-nerd-font"
cask "font-commit-mono"
cask "font-hubot-sans"
cask "font-hack-nerd-font"
cask "font-caskaydia-mono-nerd-font"
cask "font-geist-mono-nerd-font"

# Applications: development
cask "visual-studio-code@insiders"
cask "zed"
cask "betterdisplay"
cask "bettermouse"
cask "ghostty"
cask "bruno"
cask "rectangle"
cask "1password"
cask "raycast"

# Applications: browsers
cask "google-chrome"
cask "firefox"

# Applications: communication
cask "slack"
cask "zoom"

# Applications: productivity
cask "obsidian"
cask "figma"
cask "handy"

# Languages and build dependencies
brew "go"
brew "rustup"
brew "mise"
brew "python@3.13"
brew "tailscale"

# CLI programs
brew "zsh"
brew "eza"
brew "bat"
brew "duf"
brew "gh"
brew "procs"
brew "btop"
brew "ripgrep"
brew "cloudflare-speed-cli"
brew "lazygit"
brew "ncdu"
cask "1password-cli"
brew "yazi"
brew "git-delta"
brew "snitch"
brew "mole"
brew "hunk"

# Zsh plugins and prompt
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"
brew "zsh-history-substring-search"
