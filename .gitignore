.DS_Store
node_modules

# Machine-specific profile selected during setup.
.profile

.config/newsboat/*
.config/lazysql/*

# Project skill links generated from the canonical .agents/skills tree.
.claude/skills/
.pi/skills/

# Generated locally by setup/aerc.sh from a private 1Password field.
.config/aerc/accounts.conf

# Herdr machine-generated runtime state.
.config/herdr/.plugins.lock
.config/herdr/*.log
.config/herdr/release-notes.json
.config/herdr/session.json

# OpenLogi machine-generated runtime state and rolling config backups.
.config/openlogi/*.lock
.config/openlogi/*.sock
.config/openlogi/overlay.claim
.config/openlogi/config.toml.backup.*
