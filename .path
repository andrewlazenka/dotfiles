#!/usr/bin/env bash

export PATH="/opt/homebrew/bin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/bin:$PATH";
export PATH="$HOME/code/andrewlazenka/dotfiles/bin:$PATH"
export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"
export PATH="$HOME/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin:$PATH"
export PATH="$PATH:$HOME/.rvm/bin"
# go binaries (GOROOT is auto-detected from the `go` binary since Go 1.9)
export PATH="$(go env GOPATH)/bin:$PATH"
# language versions are managed by mise, activated in .zshrc
# PHP builds need Homebrew's newer bison instead of macOS /usr/bin/bison
export PATH="/opt/homebrew/opt/bison/bin:$PATH"
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"


# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
