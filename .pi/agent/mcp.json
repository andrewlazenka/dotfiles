{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": false
    },
    "executor": {
      "url": "https://mcp.executor.sh/mcp"
    }
  }
}
