{
  "mcpServers": {
    "fastmail": {
      "url": "https://api.fastmail.com/mcp",
      "enabled": false
    },
    "ahrefs": {
      "url": "https://api.ahrefs.com/mcp/mcp",
      "enabled": false
    },
