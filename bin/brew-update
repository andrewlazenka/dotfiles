#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="$(dirname "$SCRIPT_DIR")"
# shellcheck source=../setup/lib/brew-profile.sh
source "$DOTFILES_ROOT/setup/lib/brew-profile.sh"

usage() {
    cat <<'EOF'
Usage: brew-update [--check] [--profile personal|work]

Update Homebrew metadata, install missing dotfiles dependencies, upgrade
installed formulae and casks, clean up old versions, and verify the selected
Brewfile.

  --check                    Only verify that the Brewfile is satisfied.
  --profile personal|work    Override the saved machine profile.
EOF
}

CHECK_ONLY=false
PROFILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)
            CHECK_ONLY=true
            shift
            ;;
        --profile)
            if [[ $# -lt 2 ]]; then
                echo "--profile requires personal or work" >&2
                usage >&2
                exit 2
            fi
            PROFILE="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

resolve_brew_profile "$DOTFILES_ROOT" "$PROFILE"

if ! command -v brew >/dev/null 2>&1; then
    echo "brew is required but was not found on PATH" >&2
    exit 1
fi

echo "Using Homebrew profile: $BREW_PROFILE"

if [[ "$CHECK_ONLY" == true ]]; then
    exec brew bundle check --file="$BREWFILE" --verbose
fi

echo "Updating Homebrew metadata..."
brew update

echo "Installing missing dependencies from $BREWFILE..."
brew bundle install --file="$BREWFILE" --no-upgrade

echo "Upgrading installed formulae and casks..."
brew upgrade
echo "Cleaning up old Homebrew versions and downloads..."
brew cleanup
echo "Verifying $BREWFILE..."
brew bundle check --file="$BREWFILE" --verbose
