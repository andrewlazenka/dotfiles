#!/usr/bin/env bash

bindkey '^h' atuin-search

_launch_tmux_session() {
    BUFFER=""
    CURSOR=0
    zle reset-prompt

    BUFFER="o"
    zle accept-line
}

zle -N _launch_tmux_session
bindkey '^xo' _launch_tmux_session

_launch_rex_project() {
    BUFFER="rex_launch"
    CURSOR=${#BUFFER}
    zle accept-line
}

zle -N _launch_rex_project
bindkey '^xw' _launch_rex_project

zle -N _ssh_connect
bindkey '^xs' _ssh_connect

bindkey -s "^f" "yazi\n"

bindkey -s "^g" "lazygit\n"

bindkey -s "^r" "gh repo view --web\n"

bindkey -s "^a" "pi\n"
